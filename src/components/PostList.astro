---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '../lib/posts';

interface Props {
	posts: CollectionEntry<'til'>[];
	groupByMonth?: boolean;
}

const { posts, groupByMonth = false } = Astro.props;
const groups = new Map<string, CollectionEntry<'til'>[]>();
for (const post of posts) {
	const key = groupByMonth ? formatDate(post.data.date).slice(0, 7) : '';
	groups.set(key, [...(groups.get(key) ?? []), post]);
}
---

{[...groups].map(([month, items]) => (
	<section>
		{month && <h2 class="month">{month}</h2>}
		<ul class="post-list">
			{items.map((post) => (
				<li>
					<a class="title" href={`/posts/${post.id}/`}>{post.data.title}</a>
					<div class="meta">
						<time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
						<span class="tags">
							{post.data.tags.map((tag) => <a class="tag" href={`/tags/${tag}/`}>{tag}</a>)}
						</span>
					</div>
				</li>
			))}
		</ul>
	</section>
))}
