---
import { render } from 'astro:content';
import TocList from '../../components/TocList.astro';
import Base from '../../layouts/Base.astro';
import { formatDate, getPosts } from '../../lib/posts';

export async function getStaticPaths() {
	const posts = await getPosts();
	return posts.map((post) => ({ params: { slug: post.id }, props: post }));
}

const post = Astro.props;
const { Content, headings } = await render(post);
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const showToc = toc.length >= 2;
---

<Base title={post.data.title} description={post.data.description}>
	<div class="post-layout">
	<article data-pagefind-body>
		<h1>{post.data.title}</h1>
		<div class="meta" data-pagefind-ignore>
			<time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
			<span class="tags">
				{post.data.tags.map((tag) => <a class="tag" href={`/tags/${tag}/`} data-pagefind-filter="tag">{tag}</a>)}
			</span>
		</div>
		{showToc && (
			<details class="toc-mobile" data-pagefind-ignore>
				<summary>目次</summary>
				<TocList items={toc} />
			</details>
		)}
		<Content />
	</article>
	{showToc && (
		<aside class="toc-side" aria-label="目次">
			<nav>
				<p class="toc-title">目次</p>
				<TocList items={toc} />
			</nav>
		</aside>
	)}
	</div>
	{showToc && (
		<script>
			// 読んでいる位置の見出しを、目次で強調する
			const links = document.querySelectorAll<HTMLAnchorElement>('.toc-side a');
			const targets = [...links].map((link) => document.getElementById(decodeURIComponent(link.hash.slice(1)))).filter((el) => el !== null);
			const update = () => {
				let current = -1;
				targets.forEach((el, i) => {
					if (el.getBoundingClientRect().top <= 120) current = i;
				});
				links.forEach((link, i) => link.classList.toggle('active', i === current));
			};
			document.addEventListener('scroll', update, { passive: true });
			update();
		</script>
	)}
</Base>
